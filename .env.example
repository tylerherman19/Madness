# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session signing key — generate with: openssl rand -base64 32
SESSION_SECRET=your-secret-here

# Admin password hash — generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=your-bcrypt-hash

# Resend email — inert unless EMAILS_ENABLED is exactly "true"
RESEND_API_KEY=re_your_resend_key
EMAILS_ENABLED=false
PASSWORD_RESET_EMAILS_ENABLED=false

# Failure + daily summary texts (email-to-SMS, e.g. 5551234567@tmomail.net).
# Sent as email, so also inert until EMAILS_ENABLED=true.
ALERT_SMS_TO=

# Vercel Cron security
CRON_SECRET=your-cron-secret

# App URL (for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public support contact (defaults to the existing pool sender)
NEXT_PUBLIC_SUPPORT_EMAIL=pool@pickandpray.org
