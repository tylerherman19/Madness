    "jose": "^6.2.3",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.3.1",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
