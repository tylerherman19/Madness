  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:db": "node scripts/test-memo-integrity.mjs",
    "test:tournament": "node scripts/test-tournament.mjs && node scripts/test-delivery.mjs",
    "test:operations": "node scripts/test-operations.mjs",
    "test:e2e": "playwright test",
    "test:e2e:legacy": "FIXTURE_LEGACY_SCHEMA=true TOURNAMENT_RELIABILITY_TEST_MODE=false playwright test --grep 'signup|failed login|reset link|pick retry|signed unsubscribe|unauthenticated jobs|signed email callbacks|deadline crossing|lost pick response'"
  },
